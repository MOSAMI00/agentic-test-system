# ========================================================
# Agentic Test System - Environment Configuration
# ========================================================

# 1. إعداد Google Gemini (الموصى به)
# احصل على المفتاح مجاناً من Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# النموذج المعتمد (الافتراضي عند استخدام مفتاح Gemini)
# خيارات متاحة:
# - gemini/gemini-1.5-flash (سريع وممتاز للاختبارات)
# - gemini/gemini-2.0-flash
# - gemini/gemini-1.5-pro
AGENTIC_TEST_LLM_MODEL=gemini/gemini-1.5-flash

# 2. إعداد OpenAI (بديل في حال أردت التبديل لـ OpenAI)
# OPENAI_API_KEY=sk-...
